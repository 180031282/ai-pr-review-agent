+def classify(value):
+    result = "unknown"
+    if value < 0:
+        result = "negative"
+    elif value == 0:
+        result = "zero"
+    elif value < 10:
+        result = "small"
+    elif value < 20:
+        result = "medium"
+    elif value < 30:
+        result = "large"
+    elif value < 40:
+        result = "huge"
+    elif value < 50:
+        result = "enormous"
+    elif value < 60:
+        result = "giant"
+    elif value < 70:
+        result = "massive"
+    elif value < 80:
+        result = "colossal"
+    elif value < 90:
+        result = "gigantic"
+    else:
+        result = "off_the_charts"
+    return result
